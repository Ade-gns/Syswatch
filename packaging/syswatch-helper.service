# Service privilégié de SysWatch : pilotage des ventilateurs uniquement.
# Démarré à la demande par D-Bus, s'arrête seul après 60 s sans mode manuel actif.
[Unit]
Description=SysWatch — service de pilotage des ventilateurs
Documentation=file:///usr/share/doc/syswatch/README-helper.md

[Service]
Type=dbus
BusName=dev.syswatch.Helper1
ExecStart=/usr/lib/syswatch/syswatch-helper

# Durcissement : le service n'a besoin que d'écrire dans /sys (pwm*) et de parler au bus.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
